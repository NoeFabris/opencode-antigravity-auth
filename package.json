{
    "name": "opencode-antigravity-auth",
    "version": "2.1.2",
    "description": "Google Antigravity OAuth for OpenCode, with account rotation, live models, and quota management",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./tui": {
            "types": "./dist/src/tui.d.ts",
            "import": "./dist/src/tui.js"
        }
    },
    "type": "module",
    "license": "MIT",
    "author": "noefabris",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NoeFabris/opencode-antigravity-auth.git"
    },
    "homepage": "https://github.com/NoeFabris/opencode-antigravity-auth#readme",
    "bugs": {
        "url": "https://github.com/NoeFabris/opencode-antigravity-auth/issues"
    },
    "keywords": [
        "opencode",
        "google",
        "antigravity",
        "gemini",
        "oauth",
        "plugin",
        "auth",
        "claude"
    ],
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "index.js",
        "tui.js",
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node script/fix-esm-imports.mjs",
        "build:schema": "npx tsx script/build-schema.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build",
        "test:e2e:models": "npx tsx script/test-models.ts",
        "test:e2e:regression": "npx tsx script/test-regression.ts",
        "test:e2e:v2": "node script/test-opencode-v2.mjs"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/proper-lockfile": "^4.1.4",
        "@vitest/coverage-v8": "^3.0.0",
        "@vitest/ui": "^3.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.0",
        "zod-to-json-schema": "^3.25.1"
    },
    "dependencies": {
        "@ai-sdk/google": "^3.0.137",
        "@opencode/client": "2.1.2",
        "@opencode/plugin": "2.1.2",
        "@opencode-ai/plugin": "^0.15.30",
        "@openauthjs/openauth": "^0.4.3",
        "proper-lockfile": "^4.1.2",
        "xdg-basedir": "^5.1.0",
        "zod": "^4.0.0"
    }
}
